            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "Action", "value": "SendMessage" },
              { "key": "Version", "value": "2012-11-05" },
              { "key": "MessageGroupId", "value": "{{walletId}}" },
              { "key": "MessageDeduplicationId", "value": "msg-{{sqsExternalId}}" },
              { "key": "MessageBody", "value": "{\"messageId\":\"msg-{{sqsExternalId}}\",\"type\":\"WagerTransactionRequested\",\"occurredAt\":\"2026-09-26T12:00:00.000Z\",\"data\":{\"providerId\":\"provider-a\",\"externalTransactionId\":\"{{sqsExternalId}}\",\"idempotencyKey\":\"provider-a:{{sqsExternalId}}\",\"playerId\":\"{{playerId}}\",\"walletId\":\"{{walletId}}\",\"roundId\":\"round-987\",\"gameId\":\"fortune-chimp\",\"kind\":\"BET\",\"money\":{\"amount\":\"40.00\",\"currency\":\"BRL\"}}}" }
            ] },
            "url": { "raw": "{{localstackUrl}}/000000000000/wager-transactions.fifo", "host": ["{{localstackUrl}}"], "path": ["000000000000", "wager-transactions.fifo"] }
          }
        },
        {
          "name": "Consultar a operacao enviada pela fila",
