        {
          "name": "Reconciliacao",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('saldo bate com o ledger', () => {",
            "  pm.response.to.have.status(200);",
            "  const body = pm.response.json();",
            "  pm.expect(body.consistent).to.eql(true);",
            "  pm.expect(body.difference.amount).to.eql('0.00');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{internalToken}}" }],
            "url": { "raw": "{{baseUrl}}/wallets/{{walletId}}/reconciliation", "host": ["{{baseUrl}}"], "path": ["wallets", "{{walletId}}", "reconciliation"] }
          }
        }
      ]
    },
