    {
      "name": "06 SQS via LocalStack",
      "description": "Requisicoes assinadas com AWS Signature usando awsAccessKey e awsSecretKey do environment. Depois de enviar, consulte a operacao pela API.",
      "auth": {
        "type": "awsv4",
        "awsv4": [
          { "key": "accessKey", "value": "{{awsAccessKey}}", "type": "string" },
          { "key": "secretKey", "value": "{{awsSecretKey}}", "type": "string" },
          { "key": "region", "value": "{{awsRegion}}", "type": "string" },
          { "key": "service", "value": "sqs", "type": "string" }
