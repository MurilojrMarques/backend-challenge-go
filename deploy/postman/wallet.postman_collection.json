{
  "info": {
    "name": "Wallet Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Roteiro manual do desafio. A collection nao contem segredos: URLs, secrets dos clients e credenciais AWS vem do environment do Postman (deploy/postman/local.postman_environment.json para o compose local). Os tokens do Keycloak sao obtidos e renovados automaticamente pelo script da collection. Comece por '00 Novo cenario' e siga a ordem das pastas. Para bater em outra replica, troque baseUrl para http://localhost:8081, 8082 ou 8083 depois de `make e2e-up`."
  },
  "variable": [
    { "key": "playerId", "value": "" },
    { "key": "walletId", "value": "" },
    { "key": "betExternalId", "value": "" },
    { "key": "lateExternalId", "value": "" },
    { "key": "sqsExternalId", "value": "" },
    { "key": "transactionId", "value": "" },
    { "key": "pendingTransactionId", "value": "" },
    { "key": "internalToken", "value": "" },
    { "key": "providerToken", "value": "" },
    { "key": "providerBToken", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const kc = pm.variables.get('keycloakUrl');",
          "const clients = [['internalToken', 'internal-service', 'internalClientSecret'], ['providerToken', 'provider-a', 'providerAClientSecret'], ['providerBToken', 'provider-b', 'providerBClientSecret']];",
          "clients.forEach(([name, clientId, secretVariable]) => {",
          "  const secret = pm.variables.get(secretVariable);",
          "  if (!secret) { console.log('defina ' + secretVariable + ' no environment do Postman; a collection nao carrega segredos'); return; }",
          "  const expiresAt = Number(pm.collectionVariables.get(name + 'ExpiresAt') || 0);",
          "  if (pm.collectionVariables.get(name) && Date.now() < expiresAt - 15000) { return; }",
          "  pm.sendRequest({",
          "    url: kc + '/realms/wallet/protocol/openid-connect/token',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "    body: { mode: 'urlencoded', urlencoded: [",
          "      { key: 'grant_type', value: 'client_credentials' },",
          "      { key: 'client_id', value: clientId },",
          "      { key: 'client_secret', value: secret }",
          "    ] }",
          "  }, (err, res) => {",
          "    if (err || res.code !== 200) { console.log('token de ' + clientId + ' falhou: ' + (err || res.code)); return; }",
          "    const body = res.json();",
          "    pm.collectionVariables.set(name, body.access_token);",
          "    pm.collectionVariables.set(name + 'ExpiresAt', String(Date.now() + body.expires_in * 1000));",
          "  });",
          "});",
          "if (!pm.collectionVariables.get('playerId')) { pm.collectionVariables.set('playerId', pm.variables.replaceIn('{{$guid}}')); }",
          "const stamp = Date.now();",
          "if (!pm.collectionVariables.get('betExternalId')) { pm.collectionVariables.set('betExternalId', 'bet-' + stamp); }",
          "if (!pm.collectionVariables.get('lateExternalId')) { pm.collectionVariables.set('lateExternalId', 'late-' + stamp); }",
          "if (!pm.collectionVariables.get('sqsExternalId')) { pm.collectionVariables.set('sqsExternalId', 'sqs-' + stamp); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Novo cenario",
      "description": "Gera um novo jogador e novos identificadores externos. Rode antes de repetir o roteiro.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const stamp = Date.now();",
              "pm.collectionVariables.set('playerId', pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('betExternalId', 'bet-' + stamp);",
              "pm.collectionVariables.set('lateExternalId', 'late-' + stamp);",
              "pm.collectionVariables.set('sqsExternalId', 'sqs-' + stamp);",
              "['walletId', 'transactionId', 'pendingTransactionId'].forEach((v) => pm.collectionVariables.set(v, ''));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('processo vivo', () => pm.response.to.have.status(200));",
              "console.log('playerId=' + pm.collectionVariables.get('playerId') + ' betExternalId=' + pm.collectionVariables.get('betExternalId'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health/live", "host": ["{{baseUrl}}"], "path": ["health", "live"] }
      }
    },
    {
      "name": "01 Saude e metricas",
      "item": [
        {
          "name": "Readiness",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 com postgres e sqs up', () => {",
            "  pm.response.to.have.status(200);",
            "  const checks = pm.response.json().checks;",
            "  pm.expect(checks.postgres).to.eql('up');",
            "  pm.expect(checks.sqs).to.eql('up');",
            "});"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health/ready", "host": ["{{baseUrl}}"], "path": ["health", "ready"] } }
        },
        {
          "name": "Metricas Prometheus",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('exposicao Prometheus', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.text()).to.include('http_server_requests_total');",
            "});"
          ] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/metrics", "host": ["{{baseUrl}}"], "path": ["metrics"] } }
        }
      ]
    },
