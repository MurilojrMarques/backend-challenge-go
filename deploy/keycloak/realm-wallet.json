{
  "realm": "wallet",
  "enabled": true,
  "displayName": "Wallet Service",
  "accessTokenLifespan": 300,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "wallet-internal", "description": "Internal wallet service: wallet operations and all queries" },
      { "name": "wallet-provider", "description": "Game provider: wager operations and own transaction queries" }
    ]
  },
  "clientScopes": [
    {
      "name": "wallet-api-audience",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "wallet-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "wallet-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["roles", "wallet-api-audience"],
  "clients": [
    {
      "clientId": "internal-service",
      "name": "Wallet internal service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "internal-service-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["roles", "wallet-api-audience"],
      "optionalClientScopes": []
    },
    {
      "clientId": "provider-a",
      "name": "Game provider A",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "provider-a-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["roles", "wallet-api-audience"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "providerId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "providerId",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "name": "Game provider B",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "provider-b-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["roles", "wallet-api-audience"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "providerId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "providerId",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "provider-short-lived",
      "name": "Game provider with 5s tokens (expiry tests)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "provider-short-lived-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": { "access.token.lifespan": "5" },
      "defaultClientScopes": ["roles", "wallet-api-audience"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "providerId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "providerId",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "no-role",
      "name": "Authenticated client without any wallet role (authorization tests)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "no-role-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["roles", "wallet-api-audience"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-internal-service",
      "enabled": true,
      "serviceAccountClientId": "internal-service",
      "realmRoles": ["wallet-internal"]
    },
    {
      "username": "service-account-provider-a",
      "enabled": true,
      "serviceAccountClientId": "provider-a",
      "realmRoles": ["wallet-provider"]
    },
    {
      "username": "service-account-provider-b",
      "enabled": true,
      "serviceAccountClientId": "provider-b",
      "realmRoles": ["wallet-provider"]
    },
    {
      "username": "service-account-provider-short-lived",
      "enabled": true,
      "serviceAccountClientId": "provider-short-lived",
      "realmRoles": ["wallet-provider"]
    },
    {
      "username": "service-account-no-role",
      "enabled": true,
      "serviceAccountClientId": "no-role",
      "realmRoles": []
    }
  ]
}
