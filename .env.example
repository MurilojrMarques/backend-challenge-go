APP_ROLES=api,consumer,outbox,pending
LOG_LEVEL=info
HTTP_ADDR=:8080
APP_START_TIMEOUT=30s
APP_STOP_TIMEOUT=25s

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wallet
WALLET_MIGRATOR_PASSWORD=wallet_migrator
WALLET_APP_PASSWORD=wallet_app
DB_POOL_MAX_CONNS=20

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=wallet
KEYCLOAK_HOSTNAME=http://keycloak:8080
KEYCLOAK_LOG_LEVEL=warn
OIDC_AUDIENCE=wallet-api

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

FAULT_ROLES=consumer,outbox
FAULT_INJECT=
